# Infraestrutura local de desenvolvimento (Docker Compose).
POSTGRES_USER=internradar
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=internradar
POSTGRES_PORT=5432

# Instância de testes separada, ativada pelo profile test.
POSTGRES_TEST_USER=internradar_test
POSTGRES_TEST_PASSWORD=CHANGE_ME_TEST_ONLY
POSTGRES_TEST_DB=internradar_test
POSTGRES_TEST_PORT=5433

# Backend privado (carregamento na S0-04; Prisma na S0-05).
API_HOST=127.0.0.1
API_PORT=3001
# Substitua o placeholder e mantenha usuário, senha, porta e banco coerentes
# com POSTGRES_*. Caracteres especiais da URL exigem percent-encoding.
DATABASE_URL=postgresql://internradar:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/internradar
