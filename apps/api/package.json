{
  "name": "@internradar/api",
  "version": "0.0.0",
  "private": true,
  "description": "API modular NestJS do InternRadar",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:http",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/persistence.integration.ts test/jobs.integration.ts",
    "test:unit": "node --import tsx --test test/environment.test.ts test/normalization.test.ts test/greenhouse.test.ts test/jobs-query.test.ts",
    "test:http": "node --import tsx --test test/health.test.ts",
    "greenhouse:check": "tsx src/connectors/greenhouse/check-greenhouse.ts",
    "sync:jobs": "tsx src/sync/sync.cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.7",
    "entities": "8.1.0",
    "htmlparser2": "12.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15"
  }
}
