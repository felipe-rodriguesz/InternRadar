{
  "name": "internradar",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace do InternRadar",
  "packageManager": "pnpm@12.12.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.12.0"
  },
  "scripts": {
    "workspace:list": "pnpm list --recursive --depth -1",
    "format": "prettier --write",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "db:config": "docker compose config --quiet",
    "db:up": "docker compose up --detach --wait --wait-timeout 90 postgres",
    "db:stop": "docker compose stop postgres",
    "db:status": "docker compose --profile test ps",
    "db:logs": "docker compose logs --tail 100 postgres",
    "db:test:up": "docker compose --profile test up --detach --wait --wait-timeout 90 postgres-test",
    "db:test:stop": "docker compose --profile test stop postgres-test",
    "db:test:logs": "docker compose --profile test logs --tail 100 postgres-test",
    "db:verify": "node scripts/verify-database.mjs",
    "dev": "pnpm --parallel --filter @internradar/api --filter @internradar/web dev",
    "typecheck": "pnpm --recursive typecheck",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive --workspace-concurrency=1 test",
    "prisma:generate": "pnpm --filter @internradar/api prisma:generate",
    "db:migrate": "pnpm --filter @internradar/api db:migrate",
    "db:seed": "pnpm --filter @internradar/api db:seed",
    "test:integration": "pnpm --filter @internradar/api test:integration",
    "greenhouse:check": "pnpm --filter @internradar/api greenhouse:check",
    "test:unit": "pnpm --filter @internradar/api test:unit",
    "sync:jobs": "pnpm --filter @internradar/api sync:jobs"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "eslint-config-next": "16.4.0"
  }
}
